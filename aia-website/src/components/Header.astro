---
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import {
  type Locale,
  useTranslations,
  getNavItems,
  localizedPath,
} from '@/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'it' } = Astro.props;
const t = useTranslations(locale);
const navItems = getNavItems(locale, t);
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(href + '/');
const homePath = localizedPath('/', locale);
const contactPath = localizedPath('/contatti', locale);
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-lg border-b border-slate-100" id="site-header">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={homePath} class="flex items-center gap-2 font-bold text-xl text-slate-900 hover:text-primary-600 transition-colors">
        <img src="/logo-108-mark.svg" alt="108 Vision" class="w-8 h-8" />
        <span class="hidden sm:inline">108 Vision</span>
      </a>

      <div class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'px-3 py-2 text-sm font-medium rounded-md transition-all hover:bg-primary-50',
              item.href.endsWith('/wellbeing')
                ? 'ml-2 border-l border-slate-200 pl-5'
                : 'hover:text-primary-600',
              isActive(item.href)
                ? 'bg-primary-50 text-primary-700 font-semibold'
                : item.href.endsWith('/wellbeing')
                  ? 'text-primary-700'
                  : 'text-slate-600',
            ]}
          >
            {item.href.endsWith('/wellbeing') && (
              <span class="mr-1 text-[10px] font-bold uppercase tracking-wider text-primary-500">
                {locale === 'it' ? 'Prodotto' : 'Product'}
              </span>
            )}
            {item.label}
          </a>
        ))}
      </div>

      <div class="hidden lg:flex items-center gap-3">
        <LanguageSwitcher currentLocale={locale} />
        <a
          href={contactPath}
          class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors shadow-sm"
        >
          {t.nav.cta}
        </a>
      </div>

      <div class="flex lg:hidden items-center gap-2">
        <LanguageSwitcher currentLocale={locale} />
        <button
          type="button"
          class="p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md"
          id="mobile-menu-btn"
          aria-label={t.nav.openMenu}
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" id="menu-icon-open" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" class="hidden" id="menu-icon-close" />
          </svg>
        </button>
      </div>
    </div>

    <div class="hidden lg:hidden pb-4" id="mobile-menu">
      <div class="flex flex-col gap-1 pt-2 border-t border-slate-100">
        {navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'px-3 py-2 text-sm font-medium rounded-md transition-all hover:bg-primary-50',
              item.href.endsWith('/wellbeing')
                ? 'mt-2 border-t border-slate-200 pt-4'
                : 'hover:text-primary-600',
              isActive(item.href)
                ? 'bg-primary-50 text-primary-700 font-semibold'
                : item.href.endsWith('/wellbeing')
                  ? 'text-primary-700'
                  : 'text-slate-600',
            ]}
          >
            {item.href.endsWith('/wellbeing') && (
              <span class="mr-1 text-[10px] font-bold uppercase tracking-wider text-primary-500">
                {locale === 'it' ? 'Prodotto' : 'Product'}
              </span>
            )}
            {item.label}
          </a>
        ))}
        <a
          href={contactPath}
          class="mt-2 inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors"
        >
          {t.nav.cta}
        </a>
      </div>
    </div>
  </nav>
</header>

<div class="h-16"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
