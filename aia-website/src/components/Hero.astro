---
interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  image?: string;
}

const {
  title,
  subtitle,
  ctaText = 'Prenota una call gratuita',
  ctaLink = '/contatti',
  image,
} = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 lg:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
          {title}
        </h1>
        {subtitle && (
          <p class="text-lg md:text-xl text-primary-100 mb-8 leading-relaxed max-w-2xl">
            {subtitle}
          </p>
        )}
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={ctaLink}
            class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-primary-900 bg-white rounded-lg hover:bg-primary-50 transition-all shadow-lg hover:shadow-xl"
          >
            {ctaText}
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/chi-sono"
            class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white border-2 border-white/30 rounded-lg hover:bg-white/10 transition-all"
          >
            Scopri di più
          </a>
        </div>
      </div>
      {image ? (
        <div class="hidden lg:block">
          <img src={image} alt="" class="rounded-2xl shadow-2xl" loading="eager" />
        </div>
      ) : (
        <div class="hidden lg:flex items-center justify-center">
          <div class="w-80 h-80 bg-gradient-to-br from-primary-400/20 to-accent-400/20 rounded-full flex items-center justify-center backdrop-blur-sm border border-white/10">
            <div class="w-60 h-60 bg-gradient-to-br from-primary-400/30 to-accent-500/30 rounded-full flex items-center justify-center">
              <div class="w-40 h-40 bg-gradient-to-br from-white/10 to-accent-400/20 rounded-full"></div>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
