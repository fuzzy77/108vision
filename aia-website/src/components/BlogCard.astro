---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  slug: string;
  coverImage?: string;
  readTime?: string;
  tags?: string[];
}

const { title, excerpt, date, slug, coverImage, readTime, tags = [] } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('it-IT', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group flex flex-col bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-lg transition-all duration-300">
  <!-- Cover Image -->
  <a href={`/blog/${slug}`} class="block overflow-hidden">
    {coverImage ? (
      <img
        src={coverImage}
        alt={title}
        class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-48 bg-gradient-to-br from-primary-100 to-primary-200 flex items-center justify-center">
        <svg class="w-12 h-12 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
      </div>
    )}
  </a>

  <!-- Content -->
  <div class="flex-1 p-6">
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.slice(0, 2).map((tag) => (
          <span class="px-2 py-0.5 text-xs font-medium bg-primary-50 text-primary-700 rounded">
            {tag}
          </span>
        ))}
      </div>
    )}

    <a href={`/blog/${slug}`} class="block">
      <h3 class="text-lg font-semibold text-slate-900 mb-2 group-hover:text-primary-600 transition-colors line-clamp-2">
        {title}
      </h3>
    </a>

    <p class="text-sm text-slate-600 mb-4 line-clamp-3">
      {excerpt}
    </p>

    <div class="flex items-center justify-between text-xs text-slate-500 mt-auto">
      <time datetime={date}>{formattedDate}</time>
      {readTime && <span>{readTime}</span>}
    </div>
  </div>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
