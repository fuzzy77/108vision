---
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import PricingTable from '@/components/PricingTable.astro';
import {
  type Locale,
  useTranslations,
  localizedPath,
  getPubblicaAmministrazioneContent,
} from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const c = getPubblicaAmministrazioneContent(locale);
const homePath = localizedPath('/', locale);
const contactPath = localizedPath('/contatti', locale);
---

<ServiceLayout
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  heroTitle={c.hero.title}
  heroSubtitle={c.hero.subtitle}
  breadcrumbs={[
    { label: t.common.home, href: homePath },
    { label: c.breadcrumb },
  ]}
>
  <!-- Context -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-8 text-center">{c.context.title}</h2>
      <p class="text-lg text-slate-600 text-center leading-relaxed mb-12">
        {c.context.description}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 bg-blue-50 rounded-xl text-center">
          <div class="text-2xl mb-2">📋</div>
          <h3 class="font-semibold text-slate-900 mb-1">{c.context.card1.title}</h3>
          <p class="text-xs text-slate-600">{c.context.card1.description}</p>
        </div>
        <div class="p-6 bg-blue-50 rounded-xl text-center">
          <div class="text-2xl mb-2">💰</div>
          <h3 class="font-semibold text-slate-900 mb-1">{c.context.card2.title}</h3>
          <p class="text-xs text-slate-600">{c.context.card2.description}</p>
        </div>
        <div class="p-6 bg-blue-50 rounded-xl text-center">
          <div class="text-2xl mb-2">⏱️</div>
          <h3 class="font-semibold text-slate-900 mb-1">{c.context.card3.title}</h3>
          <p class="text-xs text-slate-600">{c.context.card3.description}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{c.features.title}</h2>
      </div>
      <FeatureGrid features={c.features.items} columns={3} />
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{c.pricing.title}</h2>
        <p class="text-lg text-slate-600">
          {c.pricing.subtitle}
        </p>
      </div>
      <PricingTable
        plans={c.pricing.plans}
        recommendedLabel={t.service.recommended}
        defaultCtaLink={contactPath}
      />
    </div>
  </section>
</ServiceLayout>
