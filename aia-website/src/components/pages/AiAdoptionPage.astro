---
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import PricingTable from '@/components/PricingTable.astro';
import ServicePdfSection from '@/components/ServicePdfSection.astro';
import { type Locale, useTranslations, localizedPath, getAiAdoptionContent } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const c = getAiAdoptionContent(locale);
const homePath = localizedPath('/', locale);
const contactPath = localizedPath('/contatti', locale);
---

<ServiceLayout
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  heroTitle={c.hero.title}
  heroSubtitle={c.hero.subtitle}
  breadcrumbs={[
    { label: t.common.home, href: homePath },
    { label: c.breadcrumb },
  ]}
>
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-6">{c.dilemma.heading}</h2>
        <p class="text-lg text-slate-600 leading-relaxed">{c.dilemma.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="p-6 bg-amber-50 rounded-xl border border-amber-100">
          <h3 class="font-semibold text-slate-900 mb-2">{c.dilemma.compare.without.title}</h3>
          <ul class="text-sm text-slate-600 space-y-2">
            {c.dilemma.compare.without.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="p-6 bg-green-50 rounded-xl border border-green-100">
          <h3 class="font-semibold text-slate-900 mb-2">{c.dilemma.compare.with.title}</h3>
          <ul class="text-sm text-slate-600 space-y-2">
            {c.dilemma.compare.with.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{c.process.heading}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        {c.process.steps.map((step, index) => (
          <div class="text-center p-6">
            <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-lg font-bold">
              {index + 1}
            </div>
            <h3 class="font-semibold text-slate-900 mb-2">{step.title}</h3>
            <p class="text-sm text-slate-600">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{c.features.heading}</h2>
      </div>
      <FeatureGrid features={c.features.items} columns={3} />
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{t.service.packagesHeading}</h2>
        <p class="text-lg text-slate-600">{t.service.packagesSubheading}</p>
      </div>
      <PricingTable plans={c.plans} recommendedLabel={t.service.recommended} defaultCtaLink={contactPath} />
    </div>
  </section>

  <ServicePdfSection locale={locale} guidePath={c.pdfGuidePath} />
</ServiceLayout>
