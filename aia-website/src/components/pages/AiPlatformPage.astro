---
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import PricingTable from '@/components/PricingTable.astro';
import ServicePdfSection from '@/components/ServicePdfSection.astro';
import {
  type Locale,
  useTranslations,
  localizedPath,
  getAiPlatformContent,
} from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const c = getAiPlatformContent(locale);
const homePath = localizedPath('/', locale);
const contactPath = localizedPath('/contatti', locale);
---

<ServiceLayout
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  heroTitle={c.hero.title}
  heroSubtitle={c.hero.subtitle}
  breadcrumbs={[
    { label: t.common.home, href: homePath },
    { label: c.breadcrumb },
  ]}
>
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-6">{c.problem.heading}</h2>
        <p class="text-lg text-slate-600 leading-relaxed">{c.problem.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {c.problem.cards.map((card) => (
          <div class="p-6 bg-red-50 rounded-xl border border-red-100">
            <h3 class="font-semibold text-slate-900 mb-2">{card.title}</h3>
            <p class="text-sm text-slate-600">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-6">{c.solution.heading}</h2>
        <p class="text-lg text-slate-600 leading-relaxed">{c.solution.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {c.solution.cards.map((card) => (
          <div class="p-6 bg-emerald-50 rounded-xl border border-emerald-100 text-center">
            <div class="text-3xl mb-3">{card.icon}</div>
            <h3 class="font-semibold text-slate-900 mb-2">{card.title}</h3>
            <p class="text-sm text-slate-600">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{c.comparison.heading}</h2>
        <p class="text-lg text-slate-600">{c.comparison.subheading}</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border border-slate-200 rounded-xl overflow-hidden">
          <thead class="bg-slate-50">
            <tr>
              {c.comparison.columns.map((col, i) => (
                <th class={`px-4 py-3 font-semibold ${i === 1 ? 'text-primary-700 bg-primary-50' : 'text-slate-900'}`}>
                  {col}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {c.comparison.rows.map((row) => (
              <tr>
                <td class="px-4 py-3 text-slate-700">{row.feature}</td>
                <td class="px-4 py-3 font-medium text-emerald-700 bg-primary-50/30">{row.ai108}</td>
                <td class="px-4 py-3 text-slate-500">{row.chatgpt}</td>
                <td class="px-4 py-3 text-slate-500">{row.cursor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{c.features.heading}</h2>
        <p class="text-lg text-slate-600">{c.features.subheading}</p>
      </div>
      <FeatureGrid features={c.features.items} columns={3} />
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{t.service.packagesHeading}</h2>
        <p class="text-lg text-slate-600">{t.service.packagesSubheading}</p>
      </div>
      <PricingTable
        plans={c.plans}
        recommendedLabel={t.service.recommended}
        defaultCtaLink={contactPath}
      />
    </div>
  </section>

  <ServicePdfSection locale={locale} guidePath={c.pdfGuidePath} />

  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-12 text-center">{t.service.faqHeading}</h2>
      <div class="space-y-6">
        {c.faqs.map((faq) => (
          <details class="group p-6 bg-slate-50 rounded-xl border border-slate-200">
            <summary class="flex items-center justify-between cursor-pointer text-lg font-semibold text-slate-900 list-none">
              {faq.q}
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-4 text-slate-600 leading-relaxed">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</ServiceLayout>
