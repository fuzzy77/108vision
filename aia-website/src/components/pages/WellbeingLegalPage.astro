---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  type Locale,
  localizedPath,
  getWellbeingLegalContent,
  type WellbeingLegalPage,
} from '@/i18n';

interface Props {
  locale: Locale;
  page: WellbeingLegalPage;
}

const { locale, page } = Astro.props;
const legal = getWellbeingLegalContent(locale);
const c = legal.pages[page];
const backHref = localizedPath('/wellbeing', locale);
const title = `${c.heading} — WellBeing`;
---

<BaseLayout locale={locale} title={title} description={c.intro}>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Outfit:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

  <div class="wbl-root">
    <section class="wbl-hero">
      <a href={backHref} class="wbl-back">{legal.backLabel}</a>
      <p class="wbl-brand">{legal.brand}</p>
      <h1>{c.heading}</h1>
      <p class="wbl-intro">{c.intro}</p>
    </section>

    <section class="wbl-body">
      <div class="wbl-wrap">
        {c.body.map((para) => (
          <p>{para}</p>
        ))}

        <div class="wbl-actions">
          <a href={c.externalUrl} class="wbl-btn" target="_blank" rel="noopener noreferrer">
            {c.externalLabel}
          </a>
          {c.email && (
            <a href={`mailto:${c.email}`} class="wbl-link">
              {c.emailLabel}: {c.email}
            </a>
          )}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .wbl-root {
    --wb-ink: #0e1a1c;
    --wb-mist: #163036;
    --wb-foam: #eef3f1;
    --wb-sand: #c9b08a;
    --wb-display: 'Fraunces', Georgia, serif;
    --wb-sans: 'Outfit', system-ui, sans-serif;
    font-family: var(--wb-sans);
    color: var(--wb-ink);
    background: var(--wb-foam);
  }
  .wbl-hero {
    background: linear-gradient(165deg, #0a1416 0%, #123038 100%);
    color: var(--wb-foam);
    padding: 5rem 1.25rem 3.5rem;
  }
  .wbl-back {
    display: inline-block;
    color: var(--wb-sand);
    font-size: 0.85rem;
    text-decoration: none;
    margin-bottom: 1.5rem;
  }
  .wbl-back:hover {
    text-decoration: underline;
  }
  .wbl-brand {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--wb-sand);
    margin: 0 0 0.75rem;
  }
  .wbl-hero h1 {
    font-family: var(--wb-display);
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1rem;
    max-width: 40rem;
  }
  .wbl-intro {
    max-width: 40rem;
    margin: 0;
    color: rgba(238, 243, 241, 0.75);
    line-height: 1.65;
    font-weight: 300;
  }
  .wbl-body {
    padding: 3rem 1.25rem 5rem;
  }
  .wbl-wrap {
    max-width: 40rem;
    margin: 0 auto;
  }
  .wbl-wrap p {
    line-height: 1.7;
    color: #3d4f53;
    font-weight: 300;
    margin: 0 0 1.15rem;
  }
  .wbl-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(14, 26, 28, 0.1);
  }
  .wbl-btn {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.8rem 1.25rem;
    background: var(--wb-mist);
    color: var(--wb-foam);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .wbl-btn:hover {
    background: var(--wb-ink);
  }
  .wbl-link {
    color: var(--wb-mist);
    font-size: 0.95rem;
    font-weight: 500;
  }
</style>
