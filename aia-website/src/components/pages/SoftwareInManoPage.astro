---
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import PricingTable from '@/components/PricingTable.astro';
import ServicePdfSection from '@/components/ServicePdfSection.astro';
import {
  type Locale,
  useTranslations,
  localizedPath,
  getSoftwareInManoContent,
} from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const c = getSoftwareInManoContent(locale);
const homePath = localizedPath('/', locale);
const contactPath = localizedPath('/contatti', locale);
const proofPath = localizedPath(c.proof.href, locale);
---

<ServiceLayout
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  heroTitle={c.hero.title}
  heroSubtitle={c.hero.subtitle}
  breadcrumbs={[
    { label: t.common.home, href: homePath },
    { label: c.breadcrumb },
  ]}
>
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-6">{c.problem.heading}</h2>
        <p class="text-lg text-slate-600 leading-relaxed">{c.problem.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {c.problem.cards.map((card) => (
          <div class="p-6 bg-primary-50 rounded-xl">
            <h3 class="font-semibold text-slate-900 mb-2">{card.title}</h3>
            <p class="text-sm text-slate-600">{card.text}</p>
          </div>
        ))}
      </div>
      <div class="max-w-4xl mx-auto mt-12 p-8 bg-amber-50 border border-amber-100 rounded-xl text-center">
        <h3 class="text-xl font-bold text-slate-900 mb-3">{c.cost.heading}</h3>
        <p class="text-slate-700 leading-relaxed">{c.cost.text}</p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{c.method.heading}</h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">{c.method.intro}</p>
      </div>
      <FeatureGrid features={c.method.items} columns={3} />
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{c.deliverables.heading}</h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">{c.deliverables.intro}</p>
      </div>
      <FeatureGrid features={c.deliverables.items} columns={3} />
    </div>
  </section>

  <section class="py-16 bg-gradient-to-r from-slate-900 to-slate-800 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold mb-4">{c.proof.heading}</h2>
      <p class="text-slate-300 mb-8 leading-relaxed">{c.proof.text}</p>
      <a
        href={proofPath}
        class="inline-flex items-center px-6 py-3 bg-white text-slate-900 font-semibold rounded-lg hover:bg-slate-100 transition-colors"
      >
        {c.proof.cta}
      </a>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-12 text-center">{c.fit.heading}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {[c.fit.ideal, c.fit.notIdeal].map((group, index) => (
          <div class={`p-8 rounded-xl border ${index === 0 ? 'bg-primary-50 border-primary-100' : 'bg-slate-50 border-slate-200'}`}>
            <h3 class="text-xl font-semibold text-slate-900 mb-5">{group.title}</h3>
            <ul class="space-y-3">
              {group.items.map((item) => (
                <li class="flex gap-3 text-sm text-slate-700">
                  <span aria-hidden="true">{index === 0 ? '✓' : '—'}</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-12 text-center">{c.process.heading}</h2>
      <div class="space-y-8">
        {c.process.steps.map((step, index) => (
          <div class="flex gap-4">
            <div class="w-8 h-8 bg-primary-600 text-white rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold">
              {index + 1}
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">{step.title}</h3>
              <p class="text-sm text-slate-600">{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{t.service.packagesHeading}</h2>
        <p class="text-lg text-slate-600">{t.service.packagesSubheading}</p>
      </div>
      <PricingTable
        plans={c.plans}
        recommendedLabel={t.service.recommended}
        defaultCtaLink={contactPath}
      />
    </div>
  </section>

  <ServicePdfSection
    locale={locale}
    guidePath="/downloads/108vision-software-in-mano.pdf"
    title={c.pdf.title}
    description={c.pdf.description}
    cta={c.pdf.cta}
  />
  <ServicePdfSection
    locale={locale}
    guidePath="/downloads/108vision-partner-software-in-mano.pdf"
    title={c.partnerPdf.title}
    description={c.partnerPdf.description}
    cta={c.partnerPdf.cta}
  />
</ServiceLayout>
