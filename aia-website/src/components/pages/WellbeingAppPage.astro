---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type Locale, getWellbeingAppContent, localizedPath } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getWellbeingAppContent(locale);
const privacyPath = localizedPath('/wellbeing/privacy', locale);
const termsPath = localizedPath('/wellbeing/termini', locale);
const supportPath = localizedPath('/wellbeing/supporto', locale);
const playHref = c.urls.googlePlay ?? c.urls.storeLanding;
const appStoreHref = c.urls.appStore ?? c.urls.storeLanding;
const storesReady = Boolean(c.urls.googlePlay && c.urls.appStore);
---

<BaseLayout locale={locale} title={c.meta.title} description={c.meta.description} ogImage="https://www.108vision.it/app/wellbeing-feature.png">
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,700&family=Outfit:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <div class="wb-root">
    <!-- Hero: brand-first, full-bleed, one CTA group -->
    <section class="wb-hero">
      <div class="wb-hero__glow" aria-hidden="true"></div>
      <div class="wb-hero__breath" aria-hidden="true">
        <span class="wb-ring wb-ring--outer"></span>
        <span class="wb-ring wb-ring--mid"></span>
        <span class="wb-ring wb-ring--core"></span>
      </div>
      <div class="wb-hero__content">
        <p class="wb-signature">{c.brand.signature}</p>
        <h1 class="wb-brand">{c.brand.name}</h1>
        <p class="wb-claim">{c.brand.claim}</p>
        <p class="wb-intro">{c.hero.intro}</p>
        <div class="wb-cta-row">
          <a href="#download" class="wb-btn wb-btn--primary">{c.hero.primaryCta}</a>
          <a href="#features" class="wb-btn wb-btn--ghost">{c.hero.secondaryCta}</a>
        </div>
      </div>
    </section>

    <section id="features" class="wb-section">
      <div class="wb-wrap">
        <h2 class="wb-h2">{c.features.heading}</h2>
        <p class="wb-lead">{c.features.subtitle}</p>
        <div class="wb-feature-grid">
          {c.features.items.map((feature, i) => (
            <article class="wb-feature">
              <span class="wb-feature__index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="wb-section wb-section--mist">
      <div class="wb-wrap wb-ai">
        <div>
          <h2 class="wb-h2">{c.ai.heading}</h2>
          <p class="wb-lead wb-lead--left">{c.ai.intro}</p>
          <p class="wb-note">{c.ai.note}</p>
        </div>
        <div class="wb-flow" aria-label={c.ai.flowLabel}>
          {c.ai.steps.map((step, i) => (
            <>
              <div class="wb-flow__step">{step}</div>
              {i < c.ai.steps.length - 1 && <span class="wb-flow__arrow" aria-hidden="true">→</span>}
            </>
          ))}
        </div>
      </div>
    </section>

    <section class="wb-section">
      <div class="wb-wrap">
        <h2 class="wb-h2">{c.howItWorks.heading}</h2>
        <ol class="wb-steps">
          {c.howItWorks.steps.map((step, index) => (
            <li>
              <span class="wb-steps__n">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="wb-section wb-section--sand">
      <div class="wb-wrap">
        <h2 class="wb-h2">{c.packages.heading}</h2>
        <p class="wb-lead">{c.packages.subtitle}</p>
        <div class="wb-packages">
          {c.packages.items.map((pkg) => (
            <article class="wb-package">
              <h3>{pkg.title}</h3>
              <p>{pkg.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="wb-section">
      <div class="wb-wrap">
        <h2 class="wb-h2">{c.pricing.heading}</h2>
        <p class="wb-lead">{c.pricing.intro}</p>
        <div class="wb-pricing">
          {c.pricing.plans.map((plan) => (
            <article class:list={['wb-plan', plan.highlighted && 'wb-plan--hot']}>
              <h3>{plan.name}</h3>
              <p class="wb-plan__price">{plan.price}</p>
              <p>{plan.description}</p>
            </article>
          ))}
        </div>
        <p class="wb-footnote">{c.pricing.footnote}</p>
      </div>
    </section>

    <section id="download" class="wb-download">
      <div class="wb-wrap wb-download__inner">
        <img src="/app/wellbeing-icon.png" alt={c.brand.name} class="wb-download__icon" width="88" height="88" />
        <h2 class="wb-h2 wb-h2--light">{c.download.heading}</h2>
        <p class="wb-lead wb-lead--light">{c.download.intro}</p>
        <div class="wb-cta-row wb-cta-row--center">
          <a href={playHref} class="wb-btn wb-btn--primary" target="_blank" rel="noopener noreferrer">
            {storesReady ? c.download.googlePlay : c.download.storeCta}
          </a>
          {storesReady ? (
            <a href={appStoreHref} class="wb-btn wb-btn--ghost-light" target="_blank" rel="noopener noreferrer">
              {c.download.appStore}
            </a>
          ) : (
            <a href={c.urls.storeLanding} class="wb-btn wb-btn--ghost-light" target="_blank" rel="noopener noreferrer">
              {c.download.googlePlay} / {c.download.appStore}
            </a>
          )}
        </div>
        {!storesReady && <p class="wb-footnote wb-footnote--light">{c.download.comingSoon}</p>}
        <p class="wb-download__sig">{c.download.footnote}</p>
      </div>
    </section>

    <section class="wb-legal-bar">
      <div class="wb-wrap wb-legal-bar__inner">
        <p class="wb-disclaimer">{c.disclaimer}</p>
        <nav class="wb-legal-links" aria-label="WellBeing legal">
          <a href={privacyPath}>{c.legal.privacy}</a>
          <a href={termsPath}>{c.legal.terms}</a>
          <a href={supportPath}>{c.legal.support}</a>
        </nav>
        <div class="wb-built">
          <img src="/logo-108-mark.svg" alt="108 Vision" width="28" height="28" />
          <div>
            <p class="wb-built__title">{c.builtBy.title}</p>
            <p class="wb-built__text">{c.builtBy.text}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .wb-root {
    --wb-ink: #0e1a1c;
    --wb-mist: #163036;
    --wb-foam: #eef3f1;
    --wb-sand: #c9b08a;
    --wb-breath: #7ba3a8;
    --wb-glow: rgba(123, 163, 168, 0.35);
    --wb-display: 'Fraunces', Georgia, serif;
    --wb-sans: 'Outfit', system-ui, sans-serif;
    font-family: var(--wb-sans);
    color: var(--wb-ink);
    background: var(--wb-foam);
  }

  .wb-hero {
    position: relative;
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 60% at 70% 20%, rgba(123, 163, 168, 0.22), transparent 55%),
      radial-gradient(ellipse 50% 40% at 20% 80%, rgba(201, 176, 138, 0.12), transparent 50%),
      linear-gradient(165deg, #0a1416 0%, #123038 48%, #0e1a1c 100%);
    color: var(--wb-foam);
    padding: 6rem 1.25rem 4.5rem;
  }

  .wb-hero__glow {
    position: absolute;
    inset: -20% 10% auto auto;
    width: min(55vw, 520px);
    height: min(55vw, 520px);
    border-radius: 50%;
    background: radial-gradient(circle, var(--wb-glow), transparent 70%);
    filter: blur(8px);
    animation: wb-pulse 7s ease-in-out infinite;
  }

  .wb-hero__breath {
    position: absolute;
    right: max(4%, 1rem);
    top: 50%;
    transform: translateY(-50%);
    width: min(42vw, 420px);
    height: min(42vw, 420px);
    display: grid;
    place-items: center;
    opacity: 0.55;
    pointer-events: none;
  }

  .wb-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(238, 243, 241, 0.28);
  }
  .wb-ring--outer {
    inset: 0;
    animation: wb-breathe 6s ease-in-out infinite;
  }
  .wb-ring--mid {
    inset: 18%;
    border-color: rgba(123, 163, 168, 0.55);
    animation: wb-breathe 6s ease-in-out infinite 0.4s;
  }
  .wb-ring--core {
    inset: 38%;
    background: radial-gradient(circle, rgba(201, 176, 138, 0.35), transparent 70%);
    border-color: rgba(201, 176, 138, 0.5);
    animation: wb-breathe 6s ease-in-out infinite 0.8s;
  }

  .wb-hero__content {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .wb-signature {
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wb-sand);
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .wb-brand {
    font-family: var(--wb-display);
    font-weight: 700;
    font-size: clamp(3.4rem, 10vw, 5.75rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }

  .wb-claim {
    font-family: var(--wb-display);
    font-weight: 500;
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    color: rgba(238, 243, 241, 0.9);
    margin: 0 0 1.25rem;
  }

  .wb-intro {
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(238, 243, 241, 0.72);
    max-width: 34rem;
    margin: 0 0 2rem;
    font-weight: 300;
  }

  .wb-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
  .wb-cta-row--center {
    justify-content: center;
  }

  .wb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .wb-btn:hover {
    transform: translateY(-1px);
  }
  .wb-btn--primary {
    background: var(--wb-sand);
    color: var(--wb-ink);
  }
  .wb-btn--primary:hover {
    background: #d8c19a;
  }
  .wb-btn--ghost {
    border: 1px solid rgba(238, 243, 241, 0.35);
    color: var(--wb-foam);
  }
  .wb-btn--ghost:hover {
    border-color: var(--wb-foam);
    background: rgba(238, 243, 241, 0.06);
  }
  .wb-btn--ghost-light {
    border: 1px solid rgba(238, 243, 241, 0.35);
    color: var(--wb-foam);
  }

  .wb-section {
    padding: 5rem 1.25rem;
  }
  .wb-section--mist {
    background: linear-gradient(180deg, #dfe8e5 0%, var(--wb-foam) 100%);
  }
  .wb-section--sand {
    background: linear-gradient(180deg, #f6f0e6 0%, var(--wb-foam) 100%);
  }

  .wb-wrap {
    max-width: 68rem;
    margin: 0 auto;
  }

  .wb-h2 {
    font-family: var(--wb-display);
    font-size: clamp(1.85rem, 4vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    text-align: center;
    margin: 0 0 0.85rem;
  }
  .wb-h2--light {
    color: var(--wb-foam);
  }

  .wb-lead {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.75rem;
    color: #4a5c60;
    line-height: 1.65;
    font-weight: 300;
  }
  .wb-lead--left {
    text-align: left;
    margin-left: 0;
  }
  .wb-lead--light {
    color: rgba(238, 243, 241, 0.7);
  }

  .wb-feature-grid {
    display: grid;
    gap: 1.75rem 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .wb-feature-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .wb-feature {
    padding: 0.25rem 0 1rem;
    border-bottom: 1px solid rgba(14, 26, 28, 0.08);
  }
  .wb-feature__index {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--wb-breath);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .wb-feature h3 {
    font-family: var(--wb-display);
    font-size: 1.35rem;
    font-weight: 650;
    margin: 0 0 0.5rem;
  }
  .wb-feature p {
    margin: 0;
    color: #4a5c60;
    line-height: 1.6;
    font-weight: 300;
  }

  .wb-ai {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .wb-ai {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .wb-note {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: #5a6e72;
  }

  .wb-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.35rem;
    justify-content: flex-start;
  }
  .wb-flow__step {
    padding: 0.7rem 1rem;
    background: var(--wb-ink);
    color: var(--wb-foam);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .wb-flow__arrow {
    color: var(--wb-breath);
    font-size: 1.1rem;
    padding: 0 0.15rem;
  }

  .wb-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .wb-steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
  }
  .wb-steps li {
    text-align: center;
  }
  .wb-steps__n {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--wb-mist);
    color: var(--wb-foam);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.85rem;
  }
  .wb-steps h3 {
    font-family: var(--wb-display);
    font-size: 1.15rem;
    margin: 0 0 0.4rem;
  }
  .wb-steps p {
    margin: 0;
    font-size: 0.92rem;
    color: #4a5c60;
    line-height: 1.55;
    font-weight: 300;
  }

  .wb-packages {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .wb-packages {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .wb-package {
    padding: 1.5rem 0;
    border-top: 2px solid var(--wb-ink);
  }
  .wb-package h3 {
    font-family: var(--wb-display);
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }
  .wb-package p {
    margin: 0;
    color: #4a5c60;
    font-weight: 300;
    line-height: 1.55;
  }

  .wb-pricing {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .wb-pricing {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .wb-pricing {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .wb-plan {
    padding: 1.35rem 1.15rem;
    border: 1px solid rgba(14, 26, 28, 0.12);
    background: #fff;
  }
  .wb-plan--hot {
    border-color: var(--wb-mist);
    background: #f3f7f6;
  }
  .wb-plan h3 {
    font-family: var(--wb-display);
    font-size: 1.1rem;
    margin: 0 0 0.35rem;
  }
  .wb-plan__price {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--wb-mist);
    margin: 0 0 0.65rem;
  }
  .wb-plan p:last-child {
    margin: 0;
    font-size: 0.88rem;
    color: #4a5c60;
    line-height: 1.5;
    font-weight: 300;
  }

  .wb-footnote {
    text-align: center;
    margin: 1.5rem 0 0;
    font-size: 0.8rem;
    color: #6b7c80;
  }
  .wb-footnote--light {
    color: rgba(238, 243, 241, 0.55);
  }

  .wb-download {
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, rgba(123, 163, 168, 0.2), transparent 60%),
      linear-gradient(180deg, #123038 0%, #0a1416 100%);
    padding: 5rem 1.25rem;
    color: var(--wb-foam);
  }
  .wb-download__inner {
    text-align: center;
  }
  .wb-download__icon {
    width: 88px;
    height: 88px;
    border-radius: 1.25rem;
    margin: 0 auto 1.5rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }
  .wb-download__sig {
    margin-top: 1.75rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wb-sand);
  }

  .wb-legal-bar {
    padding: 3rem 1.25rem 4rem;
    background: #fff;
    border-top: 1px solid rgba(14, 26, 28, 0.08);
  }
  .wb-legal-bar__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .wb-disclaimer {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: #5a6e72;
    max-width: 48rem;
  }
  .wb-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .wb-legal-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--wb-mist);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .wb-built {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding-top: 0.5rem;
  }
  .wb-built__title {
    margin: 0 0 0.25rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .wb-built__text {
    margin: 0;
    font-size: 0.85rem;
    color: #5a6e72;
    line-height: 1.5;
    max-width: 36rem;
    font-weight: 300;
  }

  @keyframes wb-breathe {
    0%,
    100% {
      transform: scale(0.92);
      opacity: 0.55;
    }
    50% {
      transform: scale(1.05);
      opacity: 1;
    }
  }
  @keyframes wb-pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(1);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.08);
    }
  }

  @media (max-width: 900px) {
    .wb-hero__breath {
      opacity: 0.28;
      right: -8%;
    }
  }
</style>
