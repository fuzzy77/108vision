---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type Locale, getWellbeingAppContent } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getWellbeingAppContent(locale);
---

<BaseLayout locale={locale} title={c.meta.title} description={c.meta.description}>
  <section class="py-20 bg-gradient-to-br from-slate-900 via-indigo-950 to-violet-950 text-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <img src="/app/wellbeing-icon.png" alt="Wellbeing 108" class="w-16 h-16 rounded-2xl shadow-lg" />
            <div>
              <h1 class="text-3xl lg:text-4xl font-bold">{c.hero.title}</h1>
              <p class="text-violet-300 text-sm font-medium">{c.hero.subtitle}</p>
            </div>
          </div>
          <p class="text-xl text-slate-200 mb-8 leading-relaxed">{c.hero.intro}</p>
          <div class="flex flex-wrap gap-4">
            <a href="#download" class="inline-flex items-center px-6 py-3 bg-white text-slate-900 font-semibold rounded-lg hover:bg-slate-100 transition-colors">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              {c.hero.downloadCta}
            </a>
            <a href="#features" class="inline-flex items-center px-6 py-3 border border-white/30 text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
              {c.hero.featuresCta}
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <img src="/app/wellbeing-feature.png" alt="Wellbeing 108 App" class="w-full rounded-2xl shadow-2xl" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-slate-900 mb-6">{c.problem.heading}</h2>
      <p class="text-lg text-slate-600 mb-12 max-w-2xl mx-auto">{c.problem.intro}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-6 bg-red-50 rounded-xl border border-red-100 text-left">
          <h3 class="font-semibold text-slate-900 mb-3">{c.problem.traditional.title}</h3>
          <ul class="text-sm text-slate-600 space-y-2">
            {c.problem.traditional.items.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-red-400 mt-0.5 flex-shrink-0">&#10005;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-6 bg-green-50 rounded-xl border border-green-100 text-left">
          <h3 class="font-semibold text-slate-900 mb-3">{c.problem.wellbeing108.title}</h3>
          <ul class="text-sm text-slate-600 space-y-2">
            {c.problem.wellbeing108.items.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-green-500 mt-0.5 flex-shrink-0">&#10003;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{c.features.heading}</h2>
        <p class="text-lg text-slate-600">{c.features.subtitle}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {c.features.items.map((feature) => (
          <div class="p-6 bg-white rounded-xl border border-slate-200 shadow-sm">
            <div class="w-12 h-12 bg-violet-100 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" /></svg>
            </div>
            <h3 class="font-semibold text-slate-900 mb-2">{feature.title}</h3>
            <p class="text-sm text-slate-600">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-12 text-center">{c.howItWorks.heading}</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        {c.howItWorks.steps.map((step, index) => (
          <div class="text-center">
            <div class="w-14 h-14 bg-violet-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">{index + 1}</div>
            <h3 class="font-semibold text-slate-900 mb-2">{step.title}</h3>
            <p class="text-sm text-slate-600">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-gradient-to-br from-violet-50 to-indigo-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm font-semibold text-violet-600 uppercase tracking-wider mb-3">{c.ai.tag}</p>
          <h2 class="text-3xl font-bold text-slate-900 mb-6">{c.ai.heading}</h2>
          <p class="text-slate-600 mb-6">{c.ai.intro}</p>
          <ul class="space-y-3">
            {c.ai.items.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-violet-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span class="text-slate-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-lg border border-slate-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-violet-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
            </div>
            <div>
              <p class="font-semibold text-slate-900 text-sm">{c.ai.counselorLabel}</p>
              <p class="text-xs text-slate-500">{c.ai.counselorSubtitle}</p>
            </div>
          </div>
          <div class="space-y-3 text-sm text-slate-600">
            {c.ai.examples.map((example) => (
              <div class:list={['p-3 rounded-lg', example.highlighted ? 'bg-violet-50 border border-violet-100' : 'bg-slate-50']}>
                <p class:list={['font-medium mb-1', example.highlighted ? 'text-violet-800' : 'text-slate-800']}>{example.title}</p>
                <p class:list={['text-xs', example.highlighted ? 'text-violet-600' : '']}>{example.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-slate-900 mb-4">{c.pricing.heading}</h2>
      <p class="text-lg text-slate-600 mb-12">{c.pricing.intro}</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {c.pricing.items.map((item, index) => (
          <div class:list={['p-6 rounded-xl border', index === 1 ? 'bg-violet-50 border-violet-200' : 'bg-slate-50 border-slate-200']}>
            <h3 class="font-semibold text-slate-900 mb-2">{item.title}</h3>
            <p class="text-sm text-slate-600">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm font-semibold text-violet-600 uppercase tracking-wider mb-3">{c.corporate.tag}</p>
          <h2 class="text-3xl font-bold text-slate-900 mb-6">{c.corporate.heading}</h2>
          <p class="text-slate-600 mb-6">{c.corporate.intro}</p>
          <ul class="space-y-3 text-slate-700">
            {c.corporate.items.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-violet-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-lg border border-slate-100 text-center">
          <img src="/app/wellbeing-banner.png" alt="Wellbeing 108 Corporate" class="w-full rounded-lg mb-4" />
          <p class="text-sm text-slate-500">{c.corporate.imageCaption}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="download" class="py-20 bg-gradient-to-br from-slate-900 to-violet-950 text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <img src="/app/wellbeing-icon.png" alt="Wellbeing 108" class="w-20 h-20 rounded-2xl shadow-lg mx-auto mb-6" />
      <h2 class="text-3xl font-bold mb-4">{c.download.heading}</h2>
      <p class="text-lg text-slate-300 mb-8">{c.download.intro}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#" class="inline-flex items-center px-6 py-3 bg-white text-slate-900 font-semibold rounded-lg hover:bg-slate-100 transition-colors">
          {c.download.googlePlay}
        </a>
        <a href="#" class="inline-flex items-center px-6 py-3 bg-white text-slate-900 font-semibold rounded-lg hover:bg-slate-100 transition-colors">
          {c.download.appStore}
        </a>
      </div>
      <p class="text-sm text-slate-400 mt-6">{c.download.footnote}</p>
    </div>
  </section>

  <section class="py-12 bg-white border-t border-slate-100">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <div class="flex items-center justify-center gap-3 mb-3">
        <img src="/logo-108-mark.svg" alt="108 Vision" class="w-8 h-8" />
        <span class="font-semibold text-slate-900">{c.builtBy.title}</span>
      </div>
      <p class="text-sm text-slate-500">{c.builtBy.text}</p>
    </div>
  </section>
</BaseLayout>
