---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type Locale, getGrazieContent, pdfUrls } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getGrazieContent(locale);

const pdfMap = Object.fromEntries(
  Object.entries(content.pdfTitles).map(([slug, title]) => [slug, { title, url: pdfUrls[slug] ?? '#' }]),
);
---

<BaseLayout locale={locale} title={content.meta.title} description={content.meta.description}>
  <section class="py-20 bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 mb-4">{content.heading}</h1>
      <p class="text-lg text-slate-600 mb-8">{content.subheading}</p>
      <div id="download-area" class="p-6 bg-slate-50 rounded-xl border border-slate-200 mb-8">
        <p class="text-sm text-slate-500 mb-4">{content.autoDownload}</p>
        <a id="download-link" href="#" download class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          {content.downloadButton}
        </a>
      </div>
      <div class="text-slate-500 text-sm">
        <p class="mb-4">{content.followUpTitle}</p>
        <ul class="text-left max-w-sm mx-auto space-y-2">
          {content.followUpItems.map((item) => (
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ pdfMapJson: JSON.stringify(pdfMap), downloadButton: content.downloadButton }}>
  const params = new URLSearchParams(window.location.search);
  const slug = params.get('pdf');
  const map = JSON.parse(pdfMapJson);

  if (slug && map[slug]) {
    const link = document.getElementById('download-link');
    if (link) {
      link.setAttribute('href', map[slug].url);
      link.innerHTML = `<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>${downloadButton}: ${map[slug].title}`;
    }
  }
</script>
