---
const services = [
  { label: 'AI Platform', href: '/ai-platform' },
  { label: 'AI Adoption', href: '/ai-adoption' },
  { label: 'Fractional CTO', href: '/fractional-cto' },
  { label: 'Trasformazione Digitale', href: '/trasformazione-digitale' },
  { label: 'Architettura Software', href: '/architettura' },
  { label: 'Tech Leadership', href: '/leadership' },
  { label: 'Agile & DevOps', href: '/agile-devops' },
  { label: 'Sviluppo Software', href: '/sviluppo' },
  { label: 'Tech Wellbeing', href: '/wellbeing' },
  { label: 'Pubblica Amministrazione', href: '/pubblica-amministrazione' },
];

const resources = [
  { label: 'Blog', href: '/blog' },
  { label: 'Chi Siamo', href: '/chi-siamo' },
  { label: 'Wellbeing App', href: '/wellbeing-app' },
  { label: 'Contatti', href: '/contatti' },
];

const legal = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Cookie Policy', href: '/cookie' },
  { label: 'Termini di Servizio', href: '/termini' },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 font-bold text-xl text-white mb-4">
          <img src="/logo-108-mark.svg" alt="108 Vision" class="w-8 h-8" />
          108 Vision
        </a>
        <p class="text-sm text-slate-400 mb-6 leading-relaxed">
          Costruiamo la direzione, non solo il codice. Consulenza tecnologica per PMI che vogliono crescere con la tecnologia giusta.
        </p>
        <!-- Social Icons -->
        <div class="flex gap-4">
          <a href="https://linkedin.com/in/eliosscoglio" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-slate-400 hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://github.com/eliosscoglio" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-slate-400 hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://twitter.com/eliosscoglio" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="text-slate-400 hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Servizi</h3>
        <ul class="space-y-2">
          {services.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-slate-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Risorse</h3>
        <ul class="space-y-2">
          {resources.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-slate-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Legale</h3>
        <ul class="space-y-2">
          {legal.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-slate-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6 pt-4 border-t border-slate-800">
          <p class="text-xs text-slate-500">P.IVA: XXXXXXXXX</p>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-slate-800 text-center">
      <p class="text-sm text-slate-500">
        &copy; {currentYear} 108 Vision di Elios Scoglio. Tutti i diritti riservati.
      </p>
    </div>
  </div>
</footer>
