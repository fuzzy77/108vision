---
interface Props {
  quote: string;
  author: string;
  role: string;
  company: string;
}

const { quote, author, role, company } = Astro.props;
---

<div class="p-6 bg-white rounded-xl border border-slate-100 shadow-sm">
  <div class="mb-4">
    <svg class="w-8 h-8 text-primary-200" fill="currentColor" viewBox="0 0 24 24">
      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
    </svg>
  </div>
  <blockquote class="text-slate-700 text-sm leading-relaxed mb-4">
    {quote}
  </blockquote>
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 bg-primary-100 rounded-full flex items-center justify-center">
      <span class="text-primary-700 font-semibold text-xs">
        {author.split(' ').map(n => n[0]).join('')}
      </span>
    </div>
    <div>
      <p class="text-sm font-semibold text-slate-900">{author}</p>
      <p class="text-xs text-slate-500">{role}, {company}</p>
    </div>
  </div>
</div>
