---
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import PricingTable from '@/components/PricingTable.astro';

const features = [
  { title: 'PNRR e Fondi Europei', description: 'Supporto tecnico per progetti finanziati dal PNRR. Dalla progettazione alla rendicontazione.', icon: '🇪🇺' },
  { title: 'Interoperabilita', description: 'Integrazione con PDND, ANPR, PagoPA, SPID/CIE. API conformi alle Linee Guida AgID.', icon: '🔗' },
  { title: 'Cloud PA', description: 'Migrazione verso infrastrutture qualificate AgID/ACN. PSN, cloud SaaS qualificato, hybrid.', icon: '☁️' },
  { title: 'Sicurezza e Privacy', description: 'GDPR, Misure Minime AgID, Perimetro Cyber Nazionale. Assessment e remediation.', icon: '🔒' },
  { title: 'Servizi Digitali', description: 'Portali cittadino, app IO integration, notifiche digitali, identita digitale. UX per tutti.', icon: '📱' },
  { title: 'Formazione PA', description: 'Upskilling personale tecnico e dirigenziale. Digital literacy e competenze AI per la PA.', icon: '🎓' },
];

const plans = [
  {
    name: 'Consulenza Tecnica',
    price: 'Su preventivo',
    description: 'Affidamento diretto o gara',
    features: [
      'Supporto progettazione tecnica',
      'Assessment infrastrutture',
      'Piano di migrazione cloud',
      'Conformita normativa AgID',
      'Documentazione tecnica completa',
      'Supporto al RUP/DEC',
    ],
    cta: 'Richiedi informazioni',
    highlighted: false,
  },
  {
    name: 'Progetto PNRR',
    price: 'Su preventivo',
    description: 'Supporto end-to-end',
    features: [
      'Supporto scrittura progetto tecnico',
      'Architettura soluzione conforme',
      'Implementazione e integrazione',
      'Collaudo e deploy',
      'Formazione personale',
      'Documentazione AgID compliant',
      'Supporto rendicontazione tecnica',
    ],
    cta: 'Parliamone',
    highlighted: true,
  },
];
---

<ServiceLayout
  title="Pubblica Amministrazione"
  description="Consulenza digitalizzazione per enti pubblici. PNRR, interoperabilita, sicurezza. Supporto tecnico per gare e affidamenti diretti."
  heroTitle="Digitalizzazione PA: competenza, non burocrazia"
  heroSubtitle="Supporto tecnico per enti pubblici che devono digitalizzarsi davvero. PNRR, interoperabilita, cloud qualificato, sicurezza. Con pragmatismo e rispetto delle regole."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Pubblica Amministrazione' },
  ]}
>
  <!-- Context -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-8 text-center">Il contesto</h2>
      <p class="text-lg text-slate-600 text-center leading-relaxed mb-12">
        La PA italiana ha fondi, scadenze e obblighi normativi da rispettare. Servono partner tecnici
        che conoscano sia la tecnologia sia le regole del gioco: Linee Guida AgID, CAD, GDPR, Misure Minime, ACN.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 bg-blue-50 rounded-xl text-center">
          <div class="text-2xl mb-2">📋</div>
          <h3 class="font-semibold text-slate-900 mb-1">Normativa</h3>
          <p class="text-xs text-slate-600">CAD, GDPR, Linee Guida AgID, Perimetro Cyber, Piano Triennale ICT</p>
        </div>
        <div class="p-6 bg-blue-50 rounded-xl text-center">
          <div class="text-2xl mb-2">💰</div>
          <h3 class="font-semibold text-slate-900 mb-1">Finanziamenti</h3>
          <p class="text-xs text-slate-600">PNRR M1C1, fondi europei, avvisi PA Digitale 2026</p>
        </div>
        <div class="p-6 bg-blue-50 rounded-xl text-center">
          <div class="text-2xl mb-2">⏱️</div>
          <h3 class="font-semibold text-slate-900 mb-1">Scadenze</h3>
          <p class="text-xs text-slate-600">Milestone PNRR, obblighi cloud-first, interoperabilita PDND</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Aree di competenza</h2>
      </div>
      <FeatureGrid features={features} columns={3} />
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Modalita di ingaggio</h2>
        <p class="text-lg text-slate-600">
          Disponibile per affidamenti diretti (sotto soglia), RDO su MEPA, gare a procedura negoziata.
        </p>
      </div>
      <PricingTable plans={plans} />
    </div>
  </section>
</ServiceLayout>
