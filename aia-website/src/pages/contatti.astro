---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import CalendlyEmbed from '@/components/CalendlyEmbed.astro';
import BreadcrumbNav from '@/components/BreadcrumbNav.astro';
---

<BaseLayout
  title="Contatti"
  description="Prenota una call gratuita di 30 minuti o invia un messaggio. Rispondi entro 24 ore lavorative."
>
  <BreadcrumbNav items={[
    { label: 'Home', href: '/' },
    { label: 'Contatti' },
  ]} />

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-4xl font-bold text-slate-900 mb-4">Parliamo</h1>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          Prenota una discovery call gratuita di 30 minuti oppure inviami un messaggio.
          Rispondo entro 24 ore lavorative.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Contact Form -->
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Invia un messaggio</h2>
          <ContactForm />
        </div>

        <!-- Contact Info + Calendly -->
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Oppure prenota direttamente</h2>

          <!-- Direct contacts -->
          <div class="mb-8 space-y-4">
            <div class="flex items-center gap-3 p-4 bg-slate-50 rounded-lg">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <div>
                <p class="text-sm font-medium text-slate-900">Email</p>
                <a href="mailto:info@108vision.it" class="text-sm text-primary-600 hover:underline">info@108vision.it</a>
              </div>
            </div>
            <div class="flex items-center gap-3 p-4 bg-slate-50 rounded-lg">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8a6 6 0 01-12 0 6 6 0 0112 0zM2 20.5c0-3.038 2.462-5.5 5.5-5.5h5c3.038 0 5.5 2.462 5.5 5.5" />
              </svg>
              <div>
                <p class="text-sm font-medium text-slate-900">LinkedIn</p>
                <a href="https://linkedin.com/in/eliosscoglio" target="_blank" rel="noopener noreferrer" class="text-sm text-primary-600 hover:underline">linkedin.com/in/eliosscoglio</a>
              </div>
            </div>
          </div>

          <!-- Calendly -->
          <CalendlyEmbed />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-8 text-center">Domande frequenti</h2>
      <div class="space-y-4">
        <details class="p-4 bg-white rounded-lg border border-slate-200">
          <summary class="cursor-pointer font-semibold text-slate-900 list-none flex justify-between items-center">
            La discovery call e davvero gratuita?
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="mt-3 text-sm text-slate-600">Si. 30 minuti per capire la tua situazione e valutare se posso aiutarti. Nessun impegno, nessun pitch aggressivo.</p>
        </details>
        <details class="p-4 bg-white rounded-lg border border-slate-200">
          <summary class="cursor-pointer font-semibold text-slate-900 list-none flex justify-between items-center">
            Quanto tempo per ricevere una risposta?
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="mt-3 text-sm text-slate-600">Rispondo entro 24 ore lavorative. Per urgenze, specifica nel messaggio e cerchero di anticipare.</p>
        </details>
        <details class="p-4 bg-white rounded-lg border border-slate-200">
          <summary class="cursor-pointer font-semibold text-slate-900 list-none flex justify-between items-center">
            Lavori anche da remoto?
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <p class="mt-3 text-sm text-slate-600">Il 90% del mio lavoro e remoto. Per workshop e sessioni intensive in presenza, valutiamo caso per caso.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
