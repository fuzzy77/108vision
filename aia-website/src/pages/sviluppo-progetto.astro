---
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import PricingTable from '@/components/PricingTable.astro';

const features = [
  { title: 'Discovery Sprint', description: 'Prima di scrivere una riga di codice: scope definito, requisiti chiari, rischi mappati. Nessuna sorpresa dopo.', icon: '🔍' },
  { title: 'Architettura Solida', description: 'Le scelte tecniche si fanno all\'inizio, non a meta progetto. Scalabilita, manutenibilita e costi di gestione pianificati.', icon: '🏛️' },
  { title: 'Sviluppo Iterativo', description: 'Milestone visibili ogni 2 settimane. Vedi il progresso, puoi toccare con mano, feedback reale anziche promesse.', icon: '🔄' },
  { title: 'Testing Rigoroso', description: 'Unit test, integration test, UAT strutturato. Il software consegnato e software che funziona — non software che speriamo funzioni.', icon: '✅' },
  { title: 'Deploy & Training', description: 'Go-live accompagnato: deploy in produzione, formazione utenti, documentazione operativa. Non ti lasciamo soli il giorno piu importante.', icon: '🚀' },
  { title: 'Garanzia Post-Delivery', description: '30 giorni di supporto post-consegna inclusi. Bug fix garantiti. Aggiustamenti di dettaglio senza discussioni sul contratto.', icon: '🛡️' },
];

const plans = [
  {
    name: 'Progetto S',
    price: 'Su misura',
    description: 'Funzionalita singola',
    features: [
      'Discovery sprint (mezza giornata)',
      'Una funzionalita o modulo definito',
      'Testing incluso',
      'Deploy assistito',
      '30 giorni garanzia post-delivery',
      'Documentazione tecnica',
    ],
    cta: 'Parliamo del progetto',
    highlighted: false,
  },
  {
    name: 'Progetto M',
    price: 'Su misura',
    description: 'Applicazione completa',
    features: [
      'Discovery sprint completo (1 giorno)',
      'Architettura documentata',
      'Sviluppo iterativo con milestone',
      'Testing automatizzato',
      'Deploy & training utenti',
      '30 giorni supporto post-lancio',
      'Documentazione operativa completa',
    ],
    cta: 'Richiedi preventivo',
    highlighted: true,
  },
  {
    name: 'Progetto L',
    price: 'Su misura',
    description: 'Piattaforma o sistema complesso',
    features: [
      'Discovery esteso + PoC se necessario',
      'Architettura enterprise-grade',
      'Team di sviluppo dedicato',
      'QA e security review inclusi',
      'Integrazione con sistemi esistenti',
      'Change management e formazione',
      '60 giorni supporto post-lancio',
    ],
    cta: 'Parliamone',
    highlighted: false,
  },
];
---

<ServiceLayout
  title="Sviluppo Progetto"
  description="Un progetto. Scope definito, risultato garantito. Sviluppo software con milestone visibili, delivery garantita e garanzia post-consegna."
  heroTitle="Un progetto. Scope definito, risultato garantito."
  heroSubtitle="Basta con i progetti che sforano budget, slittano di mesi e consegnano meta di quello che era stato promesso. Lavoro con scope definito, milestone visibili e responsabilita chiara sul risultato."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Sviluppo Progetto' },
  ]}
>
  <!-- The Problem -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-8 text-center">Il problema</h2>
      <p class="text-lg text-slate-600 leading-relaxed text-center mb-10">
        Hai gia pagato un progetto software che non e mai finito, o e finito con il doppio del budget previsto e meta delle funzionalita promesse. Scope creep, "piccole modifiche" che si moltiplicano, preventivi gonfiati a posteriori. Il fornitore sparisce dopo il go-live.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-5 bg-slate-50 rounded-lg border border-slate-200">
          <p class="text-sm text-slate-600"><span class="font-semibold text-slate-900">"Il budget era X, la fattura e 2X"</span> — Scope definito a contratto, preventivo vincolante. Le variazioni si decidono insieme, prima di farle.</p>
        </div>
        <div class="p-5 bg-slate-50 rounded-lg border border-slate-200">
          <p class="text-sm text-slate-600"><span class="font-semibold text-slate-900">"Doveva finire a marzo, siamo a settembre"</span> — Milestone chiare ogni 2 settimane. Se uno slip e imminente, lo sai prima — non dopo.</p>
        </div>
        <div class="p-5 bg-slate-50 rounded-lg border border-slate-200">
          <p class="text-sm text-slate-600"><span class="font-semibold text-slate-900">"Funziona, ma solo quando vuole"</span> — Testing rigoroso incluso. Non consegno software che spero funzioni: consegno software che funziona.</p>
        </div>
        <div class="p-5 bg-slate-50 rounded-lg border border-slate-200">
          <p class="text-sm text-slate-600"><span class="font-semibold text-slate-900">"Dopo il go-live erano irraggiungibili"</span> — 30 giorni di supporto post-delivery inclusi. I problemi post-lancio non sono "fuori scope".</p>
        </div>
      </div>
    </div>
  </section>

  <!-- La Soluzione -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-slate-900 mb-6">La soluzione</h2>
      <p class="text-lg text-slate-600 leading-relaxed">
        Ogni progetto inizia con una Discovery Sprint: capire davvero cosa serve, mappare i rischi, definire lo scope in modo non ambiguo. Solo dopo si scrive codice. Il risultato e uno scope definito su un deliverable garantito — con milestone visibili ogni due settimane e ownership totale sul risultato finale.
      </p>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Come lavoriamo</h2>
      </div>
      <FeatureGrid features={features} columns={3} />
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Pacchetti disponibili</h2>
        <p class="text-lg text-slate-600">Ogni percorso è personalizzato. Parliamone per trovare la formula giusta.</p>
      </div>
      <PricingTable plans={plans} />
    </div>
  </section>

  <!-- PDF Omaggio -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="p-8 bg-gradient-to-br from-primary-50 to-violet-50 rounded-2xl border border-primary-100">
        <svg class="w-12 h-12 text-primary-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Scarica la guida gratuita</h3>
        <p class="text-slate-600 mb-6">Ricevi il PDF con framework, checklist e casi studio reali. Nessuna email richiesta.</p>
        <a href="/risorse" class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors">
          Scarica PDF omaggio
        </a>
      </div>
    </div>
  </section>
</ServiceLayout>
