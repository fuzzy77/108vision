---
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import PricingTable from '@/components/PricingTable.astro';

const features = [
  { title: 'Team Dedicato', description: 'Developer e figure tecniche che lavorano esclusivamente sui tuoi progetti. Conoscono il tuo codebase, il tuo dominio, le tue priorita.', icon: '👥' },
  { title: 'Continuita Operativa', description: 'Nessuna interruzione per malattia, ferie o turnover. Il lavoro continua — il team si copre internamente senza impatto su di te.', icon: '🔁' },
  { title: 'Scaling Flessibile', description: 'Aumenta o riduci la capacita su richiesta, con preavviso di un mese. Picchi di sviluppo senza assumere, rallentamenti senza licenziare.', icon: '📈' },
  { title: 'Knowledge Retention', description: 'Documentazione sistematica, knowledge base aggiornata, onboarding strutturato. La conoscenza rimane nell\'organizzazione, non nelle teste dei singoli.', icon: '🧠' },
  { title: 'Qualita Garantita', description: 'Code review sistematiche, test automatizzati, standard condivisi. La qualita non dipende dall\'umore del giorno o dalla pressione del deadline.', icon: '✅' },
  { title: 'Mobile Development', description: 'Capacita mobile nativa (iOS, Android) o cross-platform (React Native, Flutter) inclusa nei piani superiori — senza cercare figure specializzate.', icon: '📱' },
];

const plans = [
  {
    name: 'Factory Base',
    price: 'Su misura',
    description: '1 dev part-time',
    features: [
      '1 developer dedicato (20h/mese)',
      'Weekly sync call (30 min)',
      'Accesso a canale dedicato',
      'Report mensile attivita',
      'Preavviso modifiche: 30 giorni',
    ],
    cta: 'Richiedi preventivo',
    highlighted: false,
  },
  {
    name: 'Factory Standard',
    price: 'Su misura',
    description: 'Team 2-3 persone',
    features: [
      '2-3 figure tecniche dedicate',
      'Project management incluso',
      'Weekly sync + daily standup',
      'Dashboard progresso in tempo reale',
      'Code review e quality gate',
      'Documentazione tecnica aggiornata',
      'Preavviso modifiche: 30 giorni',
    ],
    cta: 'Parliamone',
    highlighted: true,
  },
  {
    name: 'Factory Enterprise',
    price: 'Su misura',
    description: 'Team completo + PM',
    features: [
      'Team completo (dev + QA + PM)',
      'Capacita mobile inclusa',
      'Architecture review mensile',
      'Security audit trimestrale',
      'SLA definiti e misurati',
      'Onboarding dedicato (2 giorni)',
      'Escalation diretta con me',
    ],
    cta: 'Parliamone',
    highlighted: false,
  },
];
---

<ServiceLayout
  title="Factory"
  description="Il tuo team esterno senza assumerlo. Sviluppo software a canone mensile con team dedicato, scaling flessibile e continuita operativa garantita."
  heroTitle="Il tuo team esterno. Senza assumerlo."
  heroSubtitle="Recruiting che dura 6 mesi, onboarding di 3 settimane, turnover che svuota il know-how. La Factory e un team di sviluppo dedicato a canone mensile: scala quando cresce, rallenta quando rallenti."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Factory' },
  ]}
>
  <!-- The Problem -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-8 text-center">Il problema</h2>
      <p class="text-lg text-slate-600 leading-relaxed text-center mb-10">
        Hai bisogno di capacita tecnica continua, ma assumere e rischioso: il mercato dei developer e competitivo, il recruiting richiede mesi, e quando finalmente hai il team — uno se ne va e porti il know-how con se. I costi fissi rendono impossibile scalare nelle due direzioni.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
        <div class="p-6 bg-slate-50 rounded-xl border border-slate-200">
          <div class="text-3xl mb-3">⏰</div>
          <p class="text-sm font-semibold text-slate-900 mb-1">6+ mesi per assumere</p>
          <p class="text-sm text-slate-600">Dal job posting al primo commit: nel frattempo il progetto aspetta e il backlog cresce.</p>
        </div>
        <div class="p-6 bg-slate-50 rounded-xl border border-slate-200">
          <div class="text-3xl mb-3">💰</div>
          <p class="text-sm font-semibold text-slate-900 mb-1">Costi fissi rigidi</p>
          <p class="text-sm text-slate-600">Developer a tempo pieno anche quando il lavoro non c'e. Impossibile adattarsi ai cicli del business.</p>
        </div>
        <div class="p-6 bg-slate-50 rounded-xl border border-slate-200">
          <div class="text-3xl mb-3">🚪</div>
          <p class="text-sm font-semibold text-slate-900 mb-1">Know-how che esce</p>
          <p class="text-sm text-slate-600">Ogni developer che lascia porta con se mesi di contesto accumulato. Ricominci da zero.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- La Soluzione -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-slate-900 mb-6">La soluzione</h2>
      <p class="text-lg text-slate-600 leading-relaxed">
        La Factory e un team esterno dedicato ai tuoi progetti, a canone mensile. Non freelance intercambiabili: persone che conoscono il tuo dominio, il tuo stack, le tue priorita. Puoi aumentare la capacita in un mese se hai un lancio, ridurla se hai una pausa. Il know-how rimane documentato e trasferibile — non bloccato nelle teste dei singoli.
      </p>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Cosa include la Factory</h2>
      </div>
      <FeatureGrid features={features} columns={3} />
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Pacchetti disponibili</h2>
        <p class="text-lg text-slate-600">Ogni percorso è personalizzato. Parliamone per trovare la formula giusta.</p>
      </div>
      <PricingTable plans={plans} />
    </div>
  </section>

  <!-- PDF Omaggio -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="p-8 bg-gradient-to-br from-primary-50 to-violet-50 rounded-2xl border border-primary-100">
        <svg class="w-12 h-12 text-primary-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Scarica la guida gratuita</h3>
        <p class="text-slate-600 mb-6">Ricevi il PDF con framework, checklist e casi studio reali. Nessuna email richiesta.</p>
        <a href="/risorse/guida-factory" class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors">
          Scarica PDF omaggio
        </a>
      </div>
    </div>
  </section>
</ServiceLayout>
