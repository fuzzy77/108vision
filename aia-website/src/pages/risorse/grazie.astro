---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pdfMap: Record<string, { title: string; url: string }> = {
  'ai-adoption': { title: 'Guida AI Adoption per PMI', url: '/pdf/AI-Adoption-Manuale-PMI.pdf' },
  'ai-platform': { title: 'Guida Piattaforma AI Aziendale', url: '/pdf/AIA-Manuale-Piattaforma.pdf' },
  'fractional-cto': { title: 'Guida Fractional CTO', url: '/pdf/FCTO-Manuale-FractionalCTO.pdf' },
  'architettura': { title: 'Guida Scaling Architetturale', url: '/pdf/ARCH-Manuale-Scaling.pdf' },
  'trasformazione-digitale': { title: 'Guida Trasformazione Digitale', url: '/pdf/DIGI-Manuale-Trasformazione.pdf' },
  'leadership': { title: 'Guida Tech Leadership', url: '/pdf/LEAD-Manuale-Leadership.pdf' },
  'agile-devops': { title: 'Guida Agile & DevOps', url: '/pdf/AGILE-Manuale-AgileDevOps.pdf' },
  'wellbeing': { title: 'Guida Tech Wellbeing', url: '/pdf/WELL-Manuale-Wellbeing.pdf' },
  'digital-starter': { title: 'Guida Digital Starter', url: '/pdf/ZERO-Manuale-FromScratch.pdf' },
  'sviluppo-progetto': { title: 'Guida Sviluppo Progetto', url: '/pdf/PROJ-Manuale-SviluppoProgetto.pdf' },
  'factory': { title: 'Guida Development Factory', url: '/pdf/FACT-Manuale-Factory.pdf' },
  'compliance-ai-act': { title: 'Guida Compliance AI Act', url: '/pdf/COMP-Manuale-ComplianceAIAct.pdf' },
  'nocode-automation': { title: 'Guida No-Code Automation', url: '/pdf/NOCODE-Manuale-Automation.pdf' },
  'data-analytics': { title: 'Guida Data & Analytics', url: '/pdf/DATA-Manuale-Analytics.pdf' },
  'pubblica-amministrazione': { title: 'Guida PA Digitale', url: '/pdf/PA-Manuale-PubblicaAmministrazione.pdf' },
};
---

<BaseLayout title="Grazie!" description="Il tuo PDF è pronto per il download.">
  <section class="py-20 bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-slate-900 mb-4">Grazie! Il tuo PDF è pronto.</h1>
      <p class="text-lg text-slate-600 mb-8">
        Clicca il bottone qui sotto per scaricarlo subito. Riceverai anche un'email con il link di download.
      </p>
      <div id="download-area" class="p-6 bg-slate-50 rounded-xl border border-slate-200 mb-8">
        <p class="text-sm text-slate-500 mb-4">Il download partirà automaticamente...</p>
        <a id="download-link" href="#" download class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Scarica PDF
        </a>
      </div>
      <div class="text-slate-500 text-sm">
        <p class="mb-4">Nei prossimi giorni riceverai anche:</p>
        <ul class="text-left max-w-sm mx-auto space-y-2">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Approfondimenti pratici sull'argomento
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Casi studio reali da PMI italiane
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Invito a una call strategica gratuita
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ pdfMapJson: JSON.stringify(pdfMap) }}>
  const params = new URLSearchParams(window.location.search);
  const slug = params.get('pdf');
  const map = JSON.parse(pdfMapJson);

  if (slug && map[slug]) {
    const link = document.getElementById('download-link');
    if (link) {
      link.setAttribute('href', map[slug].url);
      link.innerHTML = `<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>Scarica: ${map[slug].title}`;
    }
  }
</script>
