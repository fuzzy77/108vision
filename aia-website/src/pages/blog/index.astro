---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import BreadcrumbNav from '@/components/BreadcrumbNav.astro';

// In production, these would come from TinaCMS / content collection
const posts = [
  {
    title: 'Perche ogni PMI ha bisogno di un\'AI strategy nel 2025',
    excerpt: 'L\'AI non e piu un lusso per le grandi aziende. Ma adottarla senza strategia e come comprare una Ferrari per andare a fare la spesa. Ecco come costruire un piano che funziona.',
    date: '2025-01-15',
    slug: 'benvenuto',
    tags: ['AI', 'Strategia', 'PMI'],
    readTime: '5 min',
  },
  {
    title: 'Fractional CTO: quando ha senso e quando no',
    excerpt: 'Non ogni azienda ha bisogno di un Fractional CTO. Ecco i segnali che indicano che e il momento giusto e quelli che suggeriscono altre soluzioni.',
    date: '2025-01-08',
    slug: 'fractional-cto-quando-ha-senso',
    tags: ['Leadership', 'Startup'],
    readTime: '7 min',
  },
  {
    title: 'Microservizi: il piu grande malinteso dell\'industria',
    excerpt: 'Il 90% delle aziende che "fanno microservizi" ha in realta un distributed monolith. Ecco come capire se hai davvero bisogno di microservizi.',
    date: '2025-01-02',
    slug: 'microservizi-malinteso',
    tags: ['Architettura', 'Microservizi'],
    readTime: '8 min',
  },
];
---

<BaseLayout
  title="Blog"
  description="Articoli su AI, architettura software, leadership tech e trasformazione digitale. Insight pratici da 15+ anni di esperienza."
>
  <BreadcrumbNav items={[
    { label: 'Home', href: '/' },
    { label: 'Blog' },
  ]} />

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-4xl font-bold text-slate-900 mb-4">Blog</h1>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          Insight pratici su AI, architettura, leadership e trasformazione digitale.
          Niente hype, solo esperienza condensata.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <BlogCard {...post} />
        ))}
      </div>

      <!-- Pagination placeholder -->
      <div class="mt-12 flex justify-center">
        <nav class="flex items-center gap-2" aria-label="Pagination">
          <span class="px-4 py-2 text-sm font-medium bg-primary-600 text-white rounded-lg">1</span>
          <a href="#" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-lg">2</a>
          <a href="#" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-lg">3</a>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>
