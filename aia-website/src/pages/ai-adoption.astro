---
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import PricingTable from '@/components/PricingTable.astro';

const features = [
  { title: 'Assessment AI Readiness', description: 'Valutiamo la maturita digitale della tua azienda e identifichiamo le opportunita AI a maggior impatto.', icon: '🔍' },
  { title: 'Strategia AI Personalizzata', description: 'Roadmap concreta con priorita, tempi e budget. Niente slide generiche: azioni eseguibili.', icon: '🗺️' },
  { title: 'Pilot & Proof of Concept', description: 'Implementiamo il primo caso d\'uso AI in 4-6 settimane. Risultati misurabili prima di scalare.', icon: '🧪' },
  { title: 'Formazione Team', description: 'Il tuo team impara a usare e gestire gli strumenti AI. Autonomia, non dipendenza dal consulente.', icon: '🎓' },
  { title: 'Change Management', description: 'Accompagniamo le persone nel cambiamento. L\'AI funziona solo se il team la adotta davvero.', icon: '🤝' },
  { title: 'Scaling Plan', description: 'Dal pilot al roll-out completo. Metriche, governance, evoluzione continua della strategia AI.', icon: '📈' },
];

const plans = [
  {
    name: 'Assessment',
    price: 'Su misura',
    description: 'Capire dove sei e dove andare',
    features: [
      'Analisi processi aziendali',
      'Mapping opportunita AI',
      'AI Readiness Score',
      'Roadmap prioritizzata',
      'Report executive (20+ pagine)',
      'Presentazione al management',
    ],
    cta: 'Richiedi preventivo',
    highlighted: false,
  },
  {
    name: 'Full Adoption',
    price: 'Su misura',
    description: 'Dal pilot alla produzione',
    features: [
      'Assessment completo incluso',
      'Implementazione primo pilot',
      'Formazione team (16 ore)',
      'Change management',
      'Supporto 3 mesi post-lancio',
      'KPI e dashboard risultati',
      'Scaling plan documentato',
    ],
    cta: 'Parliamone',
    highlighted: true,
  },
];
---

<ServiceLayout
  title="AI Adoption"
  description="Percorso strutturato per adottare l'AI in azienda. Assessment, strategia, implementazione e formazione. Risultati misurabili."
  heroTitle="Adotta l'AI senza rischi"
  heroSubtitle="Un percorso strutturato per portare l'intelligenza artificiale nella tua azienda. Partiamo dal piccolo, misuriamo i risultati, poi scaliamo. Nessun salto nel vuoto."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'AI Adoption' },
  ]}
>
  <!-- Problem Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-6">Il dilemma dell'AI nelle PMI</h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Sai che l'AI puo trasformare il tuo business. Ma da dove iniziare? Quali strumenti? Quanto budget?
          Il rischio di investire nel progetto sbagliato paralizza la decisione. Nel frattempo i competitor avanzano.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="p-6 bg-amber-50 rounded-xl border border-amber-100">
          <h3 class="font-semibold text-slate-900 mb-2">Senza guida</h3>
          <ul class="text-sm text-slate-600 space-y-2">
            <li>Progetti AI che falliscono nel 70% dei casi</li>
            <li>Budget bruciato in sperimentazioni senza focus</li>
            <li>Team confuso e resistente al cambiamento</li>
            <li>Nessun ROI misurabile dopo 6-12 mesi</li>
          </ul>
        </div>
        <div class="p-6 bg-green-50 rounded-xl border border-green-100">
          <h3 class="font-semibold text-slate-900 mb-2">Con il percorso guidato</h3>
          <ul class="text-sm text-slate-600 space-y-2">
            <li>Primo risultato in 4-6 settimane</li>
            <li>Investimento proporzionale ai risultati</li>
            <li>Team formato e autonomo</li>
            <li>ROI documentato e scalabile</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Il percorso in 4 fasi</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="text-center p-6">
          <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-lg font-bold">1</div>
          <h3 class="font-semibold text-slate-900 mb-2">Discover</h3>
          <p class="text-sm text-slate-600">Assessment processi, dati, team. Identifichiamo le opportunita ad alto impatto.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-lg font-bold">2</div>
          <h3 class="font-semibold text-slate-900 mb-2">Design</h3>
          <p class="text-sm text-slate-600">Strategia, selezione tool, definizione KPI e piano di implementazione.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-lg font-bold">3</div>
          <h3 class="font-semibold text-slate-900 mb-2">Deliver</h3>
          <p class="text-sm text-slate-600">Pilot su caso d'uso prioritario. Risultati concreti in 4-6 settimane.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-lg font-bold">4</div>
          <h3 class="font-semibold text-slate-900 mb-2">Scale</h3>
          <p class="text-sm text-slate-600">Dal pilot al roll-out. Formazione, governance, evoluzione continua.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Cosa include il percorso</h2>
      </div>
      <FeatureGrid features={features} columns={3} />
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Pacchetti disponibili</h2>
        <p class="text-lg text-slate-600">Ogni percorso è personalizzato. Parliamone per trovare la formula giusta.</p>
      </div>
      <PricingTable plans={plans} />
    </div>
  </section>

  <!-- PDF Omaggio -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="p-8 bg-gradient-to-br from-primary-50 to-violet-50 rounded-2xl border border-primary-100">
        <svg class="w-12 h-12 text-primary-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Scarica la guida gratuita</h3>
        <p class="text-slate-600 mb-6">Ricevi il PDF con framework, checklist e casi studio reali. Nessuna email richiesta.</p>
        <a href="/risorse" class="inline-flex items-center px-6 py-3 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors">
          Scarica PDF omaggio
        </a>
      </div>
    </div>
  </section>
</ServiceLayout>
