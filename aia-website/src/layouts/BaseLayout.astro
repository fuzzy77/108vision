---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SEOHead from '@/components/SEOHead.astro';
import '@/styles/global.css';
import { htmlLang, type Locale } from '@/i18n/config';
import { useTranslations, getAlternateLocaleUrl } from '@/i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noIndex?: boolean;
  locale?: Locale;
}

const {
  title,
  description,
  ogImage,
  canonical,
  noIndex = false,
  locale = Astro.currentLocale as Locale,
} = Astro.props;

const t = useTranslations(locale);
const siteUrl = 'https://www.108vision.it';
const fullTitle = `${title} | 108 Vision - ${t.site.titleSuffix}`;
const alternateLocale: Locale = locale === 'it' ? 'en' : 'it';
const alternateUrl = `${siteUrl}${getAlternateLocaleUrl(Astro.url.pathname, alternateLocale)}`;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <slot name="head" />

    <SEOHead
      title={fullTitle}
      description={description}
      ogImage={ogImage || `${siteUrl}/og-default.png`}
      canonical={canonical || Astro.url.href}
      noIndex={noIndex}
      locale={locale}
      alternateLocale={alternateLocale}
      alternateUrl={alternateUrl}
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "108 Vision",
      "url": siteUrl,
      "description": t.site.description,
      "founder": {
        "@type": "Person",
        "name": "Elios Scoglio",
        "jobTitle": t.site.founderTitle,
      },
      "areaServed": "IT",
      "serviceType": ["AI Consulting", "Fractional CTO", "Software Architecture", "Digital Transformation"],
    })} />

    <script defer src="/_vercel/insights/script.js"></script>
    <script defer src="/_vercel/speed-insights/script.js"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-slate-900 antialiased">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
