---
import BaseLayout from './BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import CTASection from '@/components/CTASection.astro';
import BreadcrumbNav from '@/components/BreadcrumbNav.astro';
import { type Locale, useTranslations, localizedPath } from '@/i18n';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  heroTitle: string;
  heroSubtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  breadcrumbs: { label: string; href?: string }[];
}

const {
  locale = 'it',
  title,
  description,
  heroTitle,
  heroSubtitle,
  ctaText,
  ctaLink,
  breadcrumbs,
} = Astro.props;

const t = useTranslations(locale);
const contactPath = localizedPath('/contatti', locale);
const resolvedCtaText = ctaText ?? t.common.bookCall;
const resolvedCtaLink = ctaLink ?? contactPath;
---

<BaseLayout locale={locale} title={title} description={description}>
  <BreadcrumbNav items={breadcrumbs} />
  <Hero
    title={heroTitle}
    subtitle={heroSubtitle}
    ctaText={resolvedCtaText}
    ctaLink={resolvedCtaLink}
  />
  <slot />
  <CTASection
    title={t.common.readyToStart}
    description={t.common.ctaDescription}
    ctaText={resolvedCtaText}
    ctaLink={resolvedCtaLink}
  />
</BaseLayout>
