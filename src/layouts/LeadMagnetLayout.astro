---
import { getLangFromUrl, useTranslations, useLocalizedPath } from '../i18n/utils';
import leadMagnets from '../i18n/pages/lead-magnets';
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import Hero from '../components/Hero.astro';
import { Image } from 'astro:assets';
import LeadMagnetForm from '../components/LeadMagnetForm.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localizedPath = useLocalizedPath(lang);

export interface Props {
  title: string;
  description: string;
  locale: 'it' | 'en';
  slug: string; // Add slug prop
}

const { title, description, locale, slug } = Astro.props;

const currentLeadMagnet = leadMagnets[slug] && leadMagnets[slug][locale] ? leadMagnets[slug][locale] : leadMagnets.general[locale];
---

<BaseLayout title={currentLeadMagnet.title} description={currentLeadMagnet.description} locale={locale}>
  <Fragment slot="head">
    <Header {locale} />
  </Fragment>
  <main class="min-h-screen pt-16">
    <Hero
      title={currentLeadMagnet.title}
      subtitle={currentLeadMagnet.description}
      image="/assets/hero-bg-2.webp"
      alt={currentLeadMagnet.title}
    />
    <section class="py-16 md:py-24 bg-gradient-to-br from-gray-100 to-white">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="flex flex-col md:flex-row gap-12 bg-white shadow-lg rounded-lg overflow-hidden">
          <div class="md:w-1/2 p-8 flex flex-col justify-between">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-6">
              {currentLeadMagnet.pdfTitle}
            </h1>
            <div class="prose max-w-none text-gray-700 mb-8" set:html={currentLeadMagnet.longDescription} />
            <div class="space-y-4">
              {currentLeadMagnet.trustSignals.map((signal: string) => (
                <div class="flex items-center text-green-600 font-medium">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 mr-2"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    ></path>
                  </svg>
                  {signal}
                </div>
              ))}
            </div>
          </div>
          <div class="md:w-1/2 p-8 bg-gray-50 flex flex-col justify-center items-center">
            <Image
              src="/assets/lead-magnet-mockup.webp"
              alt="Lead Magnet PDF Mockup"
              width={300}
              height={400}
              class="mb-8 rounded-lg shadow-md"
            />
            <LeadMagnetForm {locale} {slug} pdfFileName={currentLeadMagnet.pdfFileName} />
          </div>
        </div>
      </div>
    </section>
    <ContactForm {locale} />
  </main>
  <Fragment slot="footer">
    <Footer {locale} />
  </Fragment>
</BaseLayout>
