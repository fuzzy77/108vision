# ============================================================
# 108 AI Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values before starting.
# NEVER commit the .env file to version control.
# ============================================================

# === Database (PostgreSQL 16 + pgvector) ===
POSTGRES_USER=aia
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=aia_platform
DATABASE_URL=postgresql://aia:changeme_in_production@postgres:5432/aia_platform

# === Redis ===
REDIS_URL=redis://redis:6379

# === Qdrant (Vector Database) ===
QDRANT_URL=http://qdrant:6333

# === LiteLLM (AI Gateway) ===
LITELLM_MASTER_KEY=sk-108ai-master-changeme
LITELLM_URL=http://litellm:4000

# === AI Model API Keys ===
# PRIMARY PROVIDERS (required — at least one):
#
# DeepSeek (recommended as primary):
#   1. Register at https://platform.deepseek.com/
#   2. Go to API Keys → Create new key
#   3. Add credit ($5-10 is enough for months of dev use)
#   Models used: deepseek-chat (V3), deepseek-reasoner (R1)
DEEPSEEK_API_KEY=sk-xxx
#
# Alibaba DashScope (recommended as fallback/secondary):
#   1. Register at https://www.alibabacloud.com/ (international)
#      OR https://dashscope.console.aliyun.com/ (Chinese console, works globally)
#   2. Enable DashScope service → API Keys → Create
#   3. Free tier: 1M tokens/month on most models
#   Models used: qwen3-8b, qwen3-32b, qwen3-235b-a22b, qwen3-30b-a3b, qwen-vl-max, text-embedding-v3
DASHSCOPE_API_KEY=sk-xxx

# FALLBACK PROVIDERS (optional — for embedding redundancy or premium tier):
#
# OpenAI (used only for embedding fallback: text-embedding-3-small):
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx
#
# Anthropic (optional premium tier — can be enabled per-tenant):
#   https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# === Traefik (Reverse Proxy / SSL) ===
# Only needed for production deployment
DOMAIN=108ai.dev
ACME_EMAIL=admin@108vision.it
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$changeme

# === Application ===
NODE_ENV=development
JWT_SECRET=changeme_jwt_secret_32chars_minimum_length
PORT=3000

# === Web Search (for web.search capability) ===
# Choose one:
# - Brave Search: https://brave.com/search/api/
# - Tavily: https://tavily.com/
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# === Backup (optional) ===
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
