# ============================================================
# 108 AI Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values before starting.
# NEVER commit the .env file to version control.
# ============================================================

# === Database (PostgreSQL 16 + pgvector) ===
POSTGRES_USER=aia
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=aia_platform
DATABASE_URL=postgresql://aia:changeme_in_production@postgres:5432/aia_platform

# === Redis ===
REDIS_URL=redis://redis:6379

# === Qdrant (Vector Database) ===
QDRANT_URL=http://qdrant:6333

# === LiteLLM (AI Gateway) ===
LITELLM_MASTER_KEY=sk-108ai-master-changeme
LITELLM_URL=http://litellm:4000

# === AI Model API Keys ===
# Primary providers (required — at least one):
# - DeepSeek: https://platform.deepseek.com/api-keys
# - Alibaba DashScope: https://dashscope.console.aliyun.com/
DEEPSEEK_API_KEY=sk-xxx
DASHSCOPE_API_KEY=sk-xxx

# Fallback providers (optional):
# - OpenAI: https://platform.openai.com/api-keys (embeddings fallback)
# - Anthropic: https://console.anthropic.com/ (premium tier, per-tenant)
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# === Traefik (Reverse Proxy / SSL) ===
# Only needed for production deployment
DOMAIN=108ai.dev
ACME_EMAIL=admin@108vision.it
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$changeme

# === Application ===
NODE_ENV=development
JWT_SECRET=changeme_jwt_secret_32chars_minimum_length
PORT=3000

# === Web Search (for web.search capability) ===
# Choose one:
# - Brave Search: https://brave.com/search/api/
# - Tavily: https://tavily.com/
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# === Backup (optional) ===
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
