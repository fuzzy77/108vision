{
  "name": "@108ai/desktop",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "bin": {
    "108ai": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node scripts/build.js",
    "build:bin": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --all",
    "build:windows": "node scripts/build.mjs --platform windows",
    "build:macos": "node scripts/build.mjs --platform macos",
    "build:linux": "node scripts/build.mjs --platform linux",
    "package:beta": "node scripts/package-beta.mjs",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/openai": "^3.0.73",
    "@aia/desktop-bridge": "workspace:*",
    "@aia/shared": "workspace:*",
    "@e2b/code-interpreter": "^2.6.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.17.8",
    "@whiskeysockets/baileys": "^6.7.0",
    "ai": "^6.0.208",
    "chokidar": "^3.6.0",
    "clipboardy": "^4.0.0",
    "e2b": "^2.30.2",
    "nanoid": "^5.0.0",
    "node-notifier": "^10.0.0",
    "open": "^10.1.0",
    "pino": "^9.0.0",
    "vscode-jsonrpc": "^9.0.0",
    "vscode-languageserver-protocol": "^3.18.0",
    "ws": "^8.17.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "qrcode-terminal": "^0.12.0",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-notifier": "^8.0.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.21.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
