{
  "name": "aia-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI Platform for SMEs — Multi-tenant AI assistant infrastructure",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:skip": "node scripts/dev.mjs --skip-infra",
    "dev:stop": "node scripts/dev.mjs --stop",
    "dev:status": "node scripts/dev.mjs --status",
    "build": "pnpm run --filter './packages/*' build && pnpm run --filter './apps/*' build",
    "lint": "pnpm run --filter './packages/*' --filter './apps/*' lint",
    "test": "pnpm run --filter './packages/*' --filter './apps/*' test",
    "clean": "docker compose down -v --remove-orphans"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "AIA Platform",
  "license": "UNLICENSED"
}
