# ============================================================
# 108 Vision — Deploy Hetzner (VPS only) — variabili d'ambiente
# Copia questo file in /opt/108vision/.env e compila TUTTI i valori.
# Genera i segreti con: openssl rand -base64 32
# NON committare mai il file compilato.
# ============================================================

# --- Domini ed email ---
# Il sito marketing (www. + apex) è servito da questo VPS (container aia-static).
# AIA_DOMAIN alimenta i vhost nginx e i router Traefik (www., app., chat., dl., api.).
AIA_DOMAIN=108vision.it
WB_DOMAIN=wellbeing.108vision.it
ACME_EMAIL=admin@108vision.it

# --- Traefik dashboard (basic auth) ---
# Genera con: htpasswd -nb admin <password>
TRAEFIK_DASHBOARD_AUTH=<GENERA>

# --- Neon PostgreSQL (region eu-central-1, endpoint -pooler) ---
# DB piattaforma (aia_platform, con pgvector)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/aia_platform?sslmode=require
# DB litellm (stesso cluster, database separato)
NEON_LITELLM_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/litellm?sslmode=require
# DB wellbeing (formato Npgsql per la API .NET)
WB_DATABASE_URL=Host=ep-xxx-pooler.eu-central-1.aws.neon.tech;Database=wellbeing;Username=USER;Password=PASSWORD

# --- Redis ---
REDIS_PASSWORD=<GENERA>

# --- Neo4j (graph KB) ---
NEO4J_PASSWORD=<GENERA>

# --- LiteLLM (AI gateway) ---
LITELLM_MASTER_KEY=sk-108ai-<GENERA>

# --- 108 AI Platform (gateway) ---
AIA_JWT_SECRET=<GENERA>
AIA_AUTH_SECRET=<GENERA>

# --- WellBeing API (.NET 9) ---
WB_JWT_KEY=<GENERA>
WB_GOOGLE_CLIENT_ID=<TUA>
WB_GOOGLE_CLIENT_SECRET=<TUA>
WB_FACEBOOK_APP_ID=<TUA>
WB_FACEBOOK_APP_SECRET=<TUA>
WB_ADMIN_APIKEY=<GENERA>
WB_DASHSCOPE_API_KEY=<TUA_KEY_DASHSCOPE>
WB_QWEN3TTS_API_KEY=<TUA_KEY_DASHSCOPE>

# --- AI Provider Keys (usate da LiteLLM) ---
DEEPSEEK_API_KEY=<TUA_KEY>
DASHSCOPE_API_KEY=<TUA_KEY>

# --- Brevo (form newsletter del sito marketing, gateway /api/public/lead) ---
BREVO_API_KEY=<TUA_KEY>
